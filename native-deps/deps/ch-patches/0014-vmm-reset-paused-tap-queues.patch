@@ -369,6 +381,42 @@ mod tests {
         queue_evt.write(1).unwrap();
         pause_evt.write(1).unwrap();
 
-        assert!(helper.pause_event_pending().unwrap());
+        assert!(helper.event_pending(EPOLL_HELPER_EVENT_PAUSE).unwrap());
     }
+
+    #[test]
+    fn kill_paused_worker_without_resume_or_queue_processing() {
+        use std::sync::{Arc, mpsc};
+        use std::time::Duration;
+
+        struct NoQueue;
+        impl EpollHelperHandler for NoQueue {
+            fn handle_event(&mut self, _: &mut EpollHelper, _: &epoll::Event)
+                -> Result<(), EpollHelperError> {
+                panic!("terminal pause processed a queued event");
+            }
+        }
+        let kill = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let pause = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let queue = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let mut helper = EpollHelper::new(&kill, &pause).unwrap();
+        helper.add_event(queue.as_raw_fd(), EPOLL_HELPER_EVENT_LAST + 1).unwrap();
+        let paused = Arc::new(AtomicBool::new(true));
+        let sync = Arc::new(Barrier::new(2));
+        pause.write(1).unwrap();
+        queue.write(1).unwrap();
+        let worker_paused = paused.clone();
+        let worker_sync = sync.clone();
+        let (tx, rx) = mpsc::channel();
+        let worker = thread::spawn(move || {
+            tx.send(helper.run(&worker_paused, &worker_sync, &mut NoQueue)).unwrap();
+        });
+        sync.wait(); // the same pause ACK used by the device manager
+        kill.write(1).unwrap();
+        worker.thread().unpark();
+        rx.recv_timeout(Duration::from_secs(1)).unwrap().unwrap();
+        worker.join().unwrap();
+        assert!(paused.load(Ordering::SeqCst));
+    }
+
 }
diff --git a/virtio-devices/src/net.rs b/virtio-devices/src/net.rs
index c55a927..b4dee9d 100644
--- a/virtio-devices/src/net.rs
+++ b/virtio-devices/src/net.rs
@@ -824,6 +824,28 @@ impl VirtioDevice for Net {
         Ok(())
     }
 
+    fn reset_paused_taps(&mut self) -> std::io::Result<()> {
+        if !self.common.paused.load(Ordering::SeqCst) {
+            return Err(std::io::Error::other("TAP release requires Pause"));
+        }
+        if let Some(kill_evt) = self.common.kill_evt.take() {
+            kill_evt.write(1)?;
+        }
+        if let Some(threads) = self.common.epoll_threads.as_ref() {
+            for t in threads { t.thread().unpark(); }
+        }
+        if let Some(t) = self.ctrl_queue_epoll_thread.as_ref() {
+            t.thread().unpark();
+        }
+        self.common.wait_for_epoll_threads();
+        if let Some(t) = self.ctrl_queue_epoll_thread.take() {
+            t.join().map_err(|_| std::io::Error::other("TAP control worker join failed"))?;
+        }
+        // Drop the device's own reference only after every worker joined.
+        self.taps.clear();
+        Ok(())
+    }
+
     fn reset(&mut self) -> Option<Arc<dyn VirtioInterrupt>> {
         let result = self.common.reset();
         event!("virtio-device", "reset", "id", &self.id);
