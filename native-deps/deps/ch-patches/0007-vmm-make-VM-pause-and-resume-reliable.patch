+            Err(Error::VcpuStateTransitionTimeout("resume"))
+        ));
+
+        state.reset_signal_acknowledgement();
+        assert!(state.wait_until_resumed(Instant::now()).is_ok());
+        state.join_thread().unwrap();
+    }
