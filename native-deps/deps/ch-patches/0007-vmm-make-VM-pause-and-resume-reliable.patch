+const KVM_SIGNAL_MASK_SIZE: usize = std::mem::size_of::<u64>();
+
+#[repr(C)]
+struct KvmSignalMask {
+    len: u32,
+    sigset: [u8; KVM_SIGNAL_MASK_SIZE],
