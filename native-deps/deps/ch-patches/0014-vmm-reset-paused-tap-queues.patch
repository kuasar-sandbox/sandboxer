-    fn pause_event_pending(&self) -> std::result::Result<bool, EpollHelperError> {
+    fn event_pending(&self, id: u16) -> std::result::Result<bool, EpollHelperError> {
         let mut events = vec![epoll::Event::new(epoll::Events::empty(), 0); EPOLL_EVENTS_LEN];
 
         loop {
@@ -160,7 +160,7 @@ impl EpollHelper {
                 Ok(count) => {
                     return Ok(events[..count]
                         .iter()
-                        .any(|event| event.data as u16 == EPOLL_HELPER_EVENT_PAUSE));
+                        .any(|event| event.data as u16 == id));
                 }
                 Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
                 Err(e) => return Err(EpollHelperError::Wait(e)),
@@ -194,15 +194,21 @@ impl EpollHelper {
         // device has been resumed.
         let mut pause_request_pending = false;
         while paused.load(Ordering::SeqCst) {
-            if self.pause_event_pending()? {
+            if self.event_pending(EPOLL_HELPER_EVENT_PAUSE)? {
                 pause_request_pending = true;
                 break;
             }
+            if self.event_pending(EPOLL_HELPER_EVENT_KILL)? {
+                return Ok(());
+            }
             thread::park();
         }
         if pause_request_pending {
             paused_sync.wait();
             while paused.load(Ordering::SeqCst) {
+                if self.event_pending(EPOLL_HELPER_EVENT_KILL)? {
+                    return Ok(());
+                }
                 thread::park();
             }
             paused_sync.wait();
@@ -257,6 +263,9 @@ impl EpollHelper {
                         // Until we have not resumed, the paused boolean will
                         // be true.
                         while paused.load(Ordering::SeqCst) {
+                            if self.event_pending(EPOLL_HELPER_EVENT_KILL)? {
+                                return Ok(());
+                            }
                             thread::park();
                         }
 
@@ -329,6 +338,9 @@ impl EpollHelper {
                         // Until we have not resumed, the paused boolean will
                         // be true.
                         while paused.load(Ordering::SeqCst) {
+                            if self.event_pending(EPOLL_HELPER_EVENT_KILL)? {
