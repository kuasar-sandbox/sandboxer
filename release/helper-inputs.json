{
  "schema": 1,
  "recipe": "scripts/build-e2e-helpers.sh",
  "dependencies": [
    "accelerator",
    "guest-runtime"
  ],
  "helpers": [
    {
      "name": "artifact-ref",
      "env": "ARTIFACT_REF_BIN",
      "cases": [
        "telemetry.usage.sh",
        "telemetry.usage-faults.sh",
        "telemetry.source-faults.sh"
      ]
    },
    {
      "name": "usage-probe",
      "env": "USAGE_PROBE_BIN",
      "cases": [
        "sandbox.*.sh",
        "snapshot.*.sh",
        "network.tapfd.sh",
        "image.manifest-boot.sh",
        "image.sandbox-assembly.sh",
        "telemetry.usage.sh",
        "telemetry.usage-faults.sh",
        "telemetry.source-faults.sh"
      ]
    },
    {
      "name": "cgroup-fork-probe",
      "env": "CGROUP_FORK_PROBE_BIN",
      "cases": [
        "sandbox.cgroup.sh"
      ]
    },
    {
      "name": "launch-recovery",
      "env": "LAUNCH_RECOVERY_BIN",
      "cases": [
        "sandbox.launch-recovery.sh",
        "sandbox.cgroup.sh",
        "snapshot.restore.sh"
      ]
    },
    {
      "name": "dirty-memory-guest",
      "env": "DIRTY_MEMORY_GUEST_BIN",
      "cases": [
        "snapshot.dirty-memory.sh",
        "snapshot.ch-compat.sh"
      ]
    },
    {
      "name": "memorycompare",
      "env": "MEMORY_COMPARE_BIN",
      "cases": [
        "snapshot.dirty-memory.sh",
        "snapshot.ch-compat.sh"
      ]
    },
    {
      "name": "memorybaseline",
      "env": "MEMORY_BASELINE_BIN",
      "cases": [
        "snapshot.dirty-memory.sh",
        "snapshot.ch-compat.sh"
      ]
    },
    {
      "name": "cloud-hypervisor-compat",
      "env": "COMPAT_CH_BIN",
      "cases": [
        "snapshot.ch-compat.sh"
      ]
    }
  ]
}
