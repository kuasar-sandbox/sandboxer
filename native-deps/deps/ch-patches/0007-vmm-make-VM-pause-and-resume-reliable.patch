+mod vcpu_state_tests {
+    use super::*;
+
+    fn active_state() -> VcpuState {
+        VcpuState {
+            handle: Some(thread::spawn(|| {})),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn signal_acknowledgement_obeys_deadline() {
+        let mut state = active_state();
+
+        assert!(matches!(
+            state.wait_until_signal_acknowledged(Instant::now()),
+            Err(Error::SignalAcknowledgeTimeout)
+        ));
+
+        state.vcpu_run_interrupted.store(true, Ordering::SeqCst);
+        assert!(state.wait_until_signal_acknowledged(Instant::now()).is_ok());
+        state.join_thread().unwrap();
+    }
+
+    #[test]
+    fn paused_state_obeys_deadline() {
+        let mut state = active_state();
+
+        assert!(matches!(
+            state.wait_until_paused(true, Instant::now()),
+            Err(Error::VcpuStateTransitionTimeout("pause"))
+        ));
+
+        state.paused.store(true, Ordering::SeqCst);
+        assert!(state.wait_until_paused(true, Instant::now()).is_ok());
+        state.join_thread().unwrap();
+    }
+
+    #[test]
+    fn resume_waits_for_signal_acknowledgement_to_clear() {
+        let mut state = active_state();
