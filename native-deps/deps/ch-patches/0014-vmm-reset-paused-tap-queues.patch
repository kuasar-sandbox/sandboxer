@@ -5401,6 +5401,34 @@ impl Aml for DeviceManager {
     }
 }
 
+impl DeviceManager {
+    pub fn reset_paused_taps(&mut self) -> std::io::Result<()> {
+        for handle in &self.virtio_devices {
+            handle.virtio_device.lock().unwrap().reset_paused_taps()?;
+        }
+        let mut config = self.config.lock().unwrap();
+        let mut tap_fds = std::collections::BTreeSet::new();
+        if let Some(nets) = config.net.as_mut() {
+            for net in nets {
+                if !net.vhost_user {
+                    tap_fds.extend(net.fds.take().unwrap_or_default());
+                }
+            }
+        }
+        if let Some(fds) = config.preserved_fds.as_mut() {
+            fds.retain(|fd| !tap_fds.contains(fd));
+        }
+        for fd in tap_fds {
+            // All Net and worker duplicates have been joined/dropped.
+            // The original inherited fd is owned by this config.
+            if unsafe { libc::close(fd) } != 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+        }
+        Ok(())
+    }
+}
