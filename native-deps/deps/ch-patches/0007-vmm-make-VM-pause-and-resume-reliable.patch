+
+    pub fn resume_with_threads(
+        &mut self,
+        extra_threads: &[&thread::Thread],
+    ) -> std::result::Result<(), MigratableError> {
+        // A runtime pause leaves the pause event pending until resume. Drain it
+        // before waking the workers so they cannot enter the next pause while
+        // they are still completing the previous one. A restored device starts
+        // paused without a pending event and therefore needs no resume ACK.
+        let wait_for_resume_ack = if self.paused.load(Ordering::SeqCst) {
+            if let Some(pause_evt) = &self.pause_evt {
+                match pause_evt.read() {
+                    Ok(_) => true,
+                    Err(e) if e.kind() == ErrorKind::WouldBlock => false,
+                    Err(e) => return Err(MigratableError::Resume(e.into())),
+                }
+            } else {
+                false
+            }
+        } else {
+            false
+        };
+
+        self.paused.store(false, Ordering::SeqCst);
+        if let Some(epoll_threads) = &self.epoll_threads {
+            for t in epoll_threads.iter() {
+                t.thread().unpark();
+            }
+        }
+        for thread in extra_threads {
+            thread.unpark();
+        }
+
+        if wait_for_resume_ack {
+            self.paused_sync.as_ref().unwrap().wait();
+        }
+
+        Ok(())
+    }
 }
 
