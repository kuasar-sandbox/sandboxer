+    fn release_inflate_descriptor(
+        memory: &GuestMemoryMmap,
+        addr: GuestAddress,
+        num_pfns: usize,
+        pfns: &mut Vec<u32>,
+    ) -> result::Result<(), Error> {
+        pfns.reserve_exact(num_pfns.min(INFLATE_BATCH_PFNS));
+        for start in (0..num_pfns).step_by(INFLATE_BATCH_PFNS) {
+            for i in start..num_pfns.min(start + INFLATE_BATCH_PFNS) {
+                let offset = (i * size_of::<u32>()) as u64;
+                let addr = addr.checked_add(offset).ok_or(Error::InvalidRequest)?;
+                pfns.push(memory.read_obj(addr).map_err(Error::GuestMemory)?);
+            }
+            pfns.sort_unstable();
+            pfns.dedup();
+            let mut remaining = pfns.as_slice();
+            while let Some(&first) = remaining.first() {
+                let base = GuestAddress(u64::from(first) << VIRTIO_BALLOON_PFN_SHIFT);
+                let region = memory.find_region(base).ok_or(Error::GuestMemory(
+                    GuestMemoryError::InvalidGuestAddress(base),
+                ))?;
+                // A region has a linear backing offset. Even adjacent guest
+                // regions can refer to unrelated parts of a backing file.
+                let last_pfn = region.last_addr().0 >> VIRTIO_BALLOON_PFN_SHIFT;
+                let mut count = 1;
+                while count < remaining.len()
+                    && u64::from(remaining[count]) == u64::from(first) + count as u64
+                    && u64::from(remaining[count]) <= last_pfn
+                {
+                    count += 1;
+                }
+                Self::release_memory_range(memory, base, count << VIRTIO_BALLOON_PFN_SHIFT)?;
+                remaining = &remaining[count..];
+            }
+            pfns.clear();
+        }
+        Ok(())
+    }
