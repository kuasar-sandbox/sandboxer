+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pause_event_pending_checks_all_ready_events() {
+        let kill_evt = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let pause_evt = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let queue_evt = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let mut helper = EpollHelper::new(&kill_evt, &pause_evt).unwrap();
+        helper
+            .add_event(queue_evt.as_raw_fd(), EPOLL_HELPER_EVENT_LAST + 1)
+            .unwrap();
+
+        // Make a queue event ready first so a one-entry epoll buffer would
+        // miss the later pause event and incorrectly park the worker.
+        queue_evt.write(1).unwrap();
+        pause_evt.write(1).unwrap();
+
+        assert!(helper.pause_event_pending().unwrap());
+    }
+}
