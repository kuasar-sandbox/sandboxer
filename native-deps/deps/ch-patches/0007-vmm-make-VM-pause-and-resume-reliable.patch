+
+fn configure_kvm_kick_signal(fd: &VcpuFd, signal: libc::c_int) -> std::io::Result<()> {
+    // Keep the kick signal pending while the vCPU thread is in userspace. KVM_RUN
+    // temporarily installs the mask below, where the kick signal is unblocked, so
+    // a kick cannot be consumed in the gap immediately before KVM_RUN.
+    let mut kick_set = unsafe { std::mem::zeroed::<libc::sigset_t>() };
+    let mut old_mask = unsafe { std::mem::zeroed::<libc::sigset_t>() };
+
+    // SAFETY: both pointers refer to initialized sigset_t values.
+    if unsafe { libc::sigemptyset(&mut kick_set) } != 0
+        || unsafe { libc::sigaddset(&mut kick_set, signal) } != 0
+    {
+        return Err(std::io::Error::last_os_error());
+    }
+
+    // pthread_sigmask returns the error number directly instead of setting errno.
+    // SAFETY: the signal sets are valid for the duration of the call.
+    let ret = unsafe { libc::pthread_sigmask(libc::SIG_BLOCK, &kick_set, &mut old_mask) };
+    if ret != 0 {
+        return Err(std::io::Error::from_raw_os_error(ret));
+    }
+
+    let mut run_mask = unsafe { std::mem::zeroed::<libc::sigset_t>() };
+    // SAFETY: sigset_t is plain data and the source and destination do not overlap.
+    unsafe {
+        std::ptr::copy_nonoverlapping(&old_mask, &mut run_mask, 1);
+    }
+
+    // SAFETY: run_mask is an initialized sigset_t.
+    if unsafe { libc::sigdelset(&mut run_mask, signal) } != 0 {
+        let error = std::io::Error::last_os_error();
+        // SAFETY: old_mask was returned by pthread_sigmask above.
+        unsafe {
+            libc::pthread_sigmask(libc::SIG_SETMASK, &old_mask, std::ptr::null_mut());
+        }
+        return Err(error);
+    }
+
+    let mut kvm_mask = KvmSignalMask {
+        len: KVM_SIGNAL_MASK_SIZE as u32,
+        sigset: [0; KVM_SIGNAL_MASK_SIZE],
+    };
+    // Linux exposes a 64-bit kernel signal mask through KVM_SET_SIGNAL_MASK.
+    // SAFETY: both buffers are valid for KVM_SIGNAL_MASK_SIZE bytes and do not overlap.
+    unsafe {
+        std::ptr::copy_nonoverlapping(
+            &run_mask as *const libc::sigset_t as *const u8,
+            kvm_mask.sigset.as_mut_ptr(),
+            KVM_SIGNAL_MASK_SIZE,
+        );
+    }
+
+    // SAFETY: fd is a vCPU fd and kvm_mask matches struct kvm_signal_mask.
+    let ret = unsafe { ioctl_with_ptr(fd, KVM_SET_SIGNAL_MASK(), &kvm_mask) };
+    if ret < 0 {
+        let error = std::io::Error::last_os_error();
+        // SAFETY: old_mask was returned by pthread_sigmask above.
+        unsafe {
+            libc::pthread_sigmask(libc::SIG_SETMASK, &old_mask, std::ptr::null_mut());
+        }
+        return Err(error);
+    }
+
+    Ok(())
+}
+
+fn consume_kvm_kick_signal(signal: libc::c_int) -> std::io::Result<()> {
+    let mut kick_set = unsafe { std::mem::zeroed::<libc::sigset_t>() };
+
+    // SAFETY: kick_set points to an initialized sigset_t value.
+    if unsafe { libc::sigemptyset(&mut kick_set) } != 0
+        || unsafe { libc::sigaddset(&mut kick_set, signal) } != 0
+    {
+        return Err(std::io::Error::last_os_error());
+    }
+
+    // The empty kick handler consumes the pending signal while it is briefly
+    // unblocked. Block it again before the next KVM_RUN so another kick cannot
+    // be consumed in the userspace gap.
+    // SAFETY: kick_set remains valid for both pthread_sigmask calls.
+    let ret = unsafe { libc::pthread_sigmask(libc::SIG_UNBLOCK, &kick_set, std::ptr::null_mut()) };
+    if ret != 0 {
+        return Err(std::io::Error::from_raw_os_error(ret));
+    }
+
+    // SAFETY: kick_set remains valid for this pthread_sigmask call.
+    let ret = unsafe { libc::pthread_sigmask(libc::SIG_BLOCK, &kick_set, std::ptr::null_mut()) };
+    if ret != 0 {
+        return Err(std::io::Error::from_raw_os_error(ret));
+    }
+
+    Ok(())
+}
