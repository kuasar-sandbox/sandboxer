+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn repeated_pause_resume_waits_for_worker_ack() {
+        const ITERATIONS: usize = 100;
+
+        let paused = Arc::new(AtomicBool::new(false));
+        let paused_sync = Arc::new(Barrier::new(2));
+        let worker_paused = paused.clone();
+        let worker_sync = paused_sync.clone();
+        let worker = thread::spawn(move || {
+            for _ in 0..ITERATIONS {
+                while !worker_paused.load(Ordering::SeqCst) {
+                    thread::yield_now();
+                }
+                worker_sync.wait();
+                while worker_paused.load(Ordering::SeqCst) {
+                    thread::park();
+                }
+                worker_sync.wait();
             }
+        });
+
+        let mut common = VirtioCommon {
+            pause_evt: Some(EventFd::new(EFD_NONBLOCK).unwrap()),
+            paused,
+            paused_sync: Some(paused_sync),
+            epoll_threads: Some(vec![worker]),
+            device_type: 1,
+            ..Default::default()
+        };
+
+        for _ in 0..ITERATIONS {
+            common.pause().unwrap();
+            common.resume().unwrap();
         }
 
-        Ok(())
+        common
+            .epoll_threads
+            .take()
+            .unwrap()
+            .pop()
+            .unwrap()
+            .join()
+            .unwrap();
+    }
+
+    #[test]
+    fn restored_resume_does_not_wait_for_runtime_ack() {
+        let mut common = VirtioCommon {
+            pause_evt: Some(EventFd::new(EFD_NONBLOCK).unwrap()),
+            paused: Arc::new(AtomicBool::new(true)),
+            paused_sync: Some(Arc::new(Barrier::new(2))),
+            ..Default::default()
+        };
+
+        common.resume_with_threads(&[]).unwrap();
+        assert!(!common.paused.load(Ordering::SeqCst));
     }
 }
